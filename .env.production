# Backend API prefix for production/public hostname
VITE_API_BASE_URL="http://camera.thanmongduong.vn:4002/"

# Default route after login
VITE_BASE_HOME_PATH="/home"
VITE_API_TIMEOUT=10000

# Website title
VITE_GLOB_APP_TITLE="Quản lý thiết bị"

# Router mode: use history mode for clean URLs like /danhmuc/donvi
VITE_ROUTER_MODE=history

# Prefix for Zustand storage to avoid clashes in multi-project setups
VITE_APP_NAMESPACE=react-antd-admin
