# Backend API prefix
VITE_API_BASE_URL="http://localhost:4002/"

# Default route after login
VITE_BASE_HOME_PATH="/home"
VITE_API_TIMEOUT=10000

# Website title
VITE_GLOB_APP_TITLE="Quản lý thiết bị"

# Router mode: use hash to avoid 404 on refresh for nested routes
VITE_ROUTER_MODE=hash

# Prefix for Zustand storage to avoid clashes in multi-project setups
VITE_APP_NAMESPACE=react-antd-admin
